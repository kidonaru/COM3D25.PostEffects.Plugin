<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <diffusion>
    <enabled>true</enabled>
    <intensity>0.45</intensity>
    <threshold>0.55</threshold>
    <blurSize>4</blurSize>
    <blendMode>Screen</blendMode>
    <excludeCharacters>false</excludeCharacters>
  </diffusion>
  <filmicBloom>
    <enabled>true</enabled>
    <threshold>1</threshold>
    <softKnee>0.7</softKnee>
    <radius>3</radius>
    <intensity>0.6</intensity>
    <highQuality>true</highQuality>
    <antiFlicker>true</antiFlicker>
    <useDirtTexture>false</useDirtTexture>
    <dirtIntensity>0</dirtIntensity>
    <dirtTexturePath />
    <streakThreshold>1</streakThreshold>
    <streakSoftKnee>0.5</streakSoftKnee>
    <streakStretch>0.75</streakStretch>
    <streakIntensity>0</streakIntensity>
    <streakVertical>false</streakVertical>
    <streak2Way>false</streak2Way>
    <streakTint>
      <r>0.55</r>
      <g>0.55</g>
      <b>0.55</b>
      <a>1</a>
    </streakTint>
    <blendMode>Screen</blendMode>
  </filmicBloom>
  <filmicBokeh>
    <enabled>true</enabled>
    <focusDistance>3</focusDistance>
    <fNumber>2</fNumber>
    <useCameraFov>true</useCameraFov>
    <focalLength>0.05</focalLength>
    <focalRange>1</focalRange>
    <kernelSize>Medium</kernelSize>
    <useARGBHalf>true</useARGBHalf>
    <radiusBasePixel>6</radiusBasePixel>
    <useHexBokeh>false</useHexBokeh>
    <angle>0</angle>
    <visualize>false</visualize>
    <maidFocus>true</maidFocus>
    <maidIndex>0</maidIndex>
  </filmicBokeh>
  <whiteBalance>
    <enabled>true</enabled>
    <temperature>8</temperature>
    <tint>2</tint>
  </whiteBalance>
  <cinematicLensAberrations>
    <enabled>true</enabled>
    <distortionEnabled>false</distortionEnabled>
    <distortionAmount>0</distortionAmount>
    <distortionCenterX>0</distortionCenterX>
    <distortionCenterY>0</distortionCenterY>
    <distortionAmountX>1</distortionAmountX>
    <distortionAmountY>1</distortionAmountY>
    <distortionScale>1</distortionScale>
    <vignetteEnabled>true</vignetteEnabled>
    <vignetteColor>
      <r>0.05</r>
      <g>0.03</g>
      <b>0.03</b>
      <a>1</a>
    </vignetteColor>
    <vignetteCenterX>0.5</vignetteCenterX>
    <vignetteCenterY>0.5</vignetteCenterY>
    <vignetteIntensity>0.8</vignetteIntensity>
    <vignetteSmoothness>1.6</vignetteSmoothness>
    <vignetteRoundness>1</vignetteRoundness>
    <vignetteBlur>0</vignetteBlur>
    <vignetteDesaturate>0</vignetteDesaturate>
    <chromaticAberrationEnabled>false</chromaticAberrationEnabled>
    <chromaticAberrationColor>
      <r>0</r>
      <g>1</g>
      <b>0</b>
      <a>1</a>
    </chromaticAberrationColor>
    <chromaticAberrationAmount>0</chromaticAberrationAmount>
  </cinematicLensAberrations>
</PostEffectsPreset>
