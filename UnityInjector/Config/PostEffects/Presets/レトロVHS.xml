<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <analogGlitch>
    <enabled>true</enabled>
    <scanLineJitter>0.15</scanLineJitter>
    <verticalJump>0.02</verticalJump>
    <horizontalShake>0.01</horizontalShake>
    <colorDrift>0.15</colorDrift>
  </analogGlitch>
  <noiseAndGrain>
    <enabled>true</enabled>
    <intensityMultiplier>0.5</intensityMultiplier>
    <generalIntensity>0.5</generalIntensity>
    <blackIntensity>1</blackIntensity>
    <whiteIntensity>1</whiteIntensity>
    <midGrey>0.2</midGrey>
    <softness>0.2</softness>
    <monochrome>false</monochrome>
    <monochromeTiling>64</monochromeTiling>
    <tilingX>64</tilingX>
    <tilingY>64</tilingY>
    <tilingZ>64</tilingZ>
  </noiseAndGrain>
  <vignetting>
    <enabled>true</enabled>
    <gameEffectDisabled>false</gameEffectDisabled>
    <mode>Simple</mode>
    <intensity>0.35</intensity>
    <blur>0.3</blur>
    <blurSpread>0.9</blurSpread>
    <chromaticAberration>1.5</chromaticAberration>
    <axialAberration>0.5</axialAberration>
    <luminanceDependency>0.25</luminanceDependency>
    <blurDistance>1</blurDistance>
  </vignetting>
  <tonemappingColorGrading>
    <enabled>true</enabled>
    <colorGradingEnabled>true</colorGradingEnabled>
    <shadows>
      <r>1</r>
      <g>1</g>
      <b>1</b>
      <a>1</a>
    </shadows>
    <midtones>
      <r>1</r>
      <g>1</g>
      <b>1</b>
      <a>1</a>
    </midtones>
    <highlights>
      <r>1</r>
      <g>1</g>
      <b>1</b>
      <a>1</a>
    </highlights>
    <temperatureShift>0.2</temperatureShift>
    <tint>0.1</tint>
    <hue>0</hue>
    <saturation>0.85</saturation>
    <vibrance>0</vibrance>
    <colorGradingValue>1</colorGradingValue>
    <colorGradingContrast>0.95</colorGradingContrast>
    <colorGradingGain>1</colorGradingGain>
    <colorGradingGamma>1.05</colorGradingGamma>
    <useDithering>true</useDithering>
  </tonemappingColorGrading>
</PostEffectsPreset>
