<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <grayscale>
    <enabled>true</enabled>
    <rampOffset>0</rampOffset>
  </grayscale>
  <contrast>
    <enabled>true</enabled>
    <intensity>0.35</intensity>
    <threshhold>0</threshhold>
    <blurSpread>1</blurSpread>
  </contrast>
  <noiseAndGrain>
    <enabled>true</enabled>
    <intensityMultiplier>0.6</intensityMultiplier>
    <generalIntensity>0.6</generalIntensity>
    <blackIntensity>1</blackIntensity>
    <whiteIntensity>0.8</whiteIntensity>
    <midGrey>0.2</midGrey>
    <softness>0.3</softness>
    <monochrome>true</monochrome>
    <monochromeTiling>64</monochromeTiling>
    <tilingX>64</tilingX>
    <tilingY>64</tilingY>
    <tilingZ>64</tilingZ>
  </noiseAndGrain>
  <vignetting>
    <enabled>true</enabled>
    <gameEffectDisabled>false</gameEffectDisabled>
    <mode>Simple</mode>
    <intensity>0.45</intensity>
    <blur>0</blur>
    <blurSpread>0.75</blurSpread>
    <chromaticAberration>0</chromaticAberration>
    <axialAberration>0.5</axialAberration>
    <luminanceDependency>0.25</luminanceDependency>
    <blurDistance>1</blurDistance>
  </vignetting>
  <filmicLetterBox>
    <enabled>true</enabled>
    <color>
      <r>0</r>
      <g>0</g>
      <b>0</b>
      <a>1</a>
    </color>
    <centerX>0.5</centerX>
    <centerY>0.5</centerY>
    <position>0.08</position>
    <smoothness>0.001</smoothness>
    <vertical>false</vertical>
  </filmicLetterBox>
</PostEffectsPreset>
