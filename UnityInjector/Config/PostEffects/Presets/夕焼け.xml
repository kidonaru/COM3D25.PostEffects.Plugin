<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <sunShafts>
    <enabled>true</enabled>
    <resolution>Normal</resolution>
    <screenBlendMode>Screen</screenBlendMode>
    <useDepthTexture>true</useDepthTexture>
    <sunColor>
      <r>1</r>
      <g>0.75</g>
      <b>0.45</b>
      <a>1</a>
    </sunColor>
    <maxRadius>0.75</maxRadius>
    <sunShaftBlurRadius>2.5</sunShaftBlurRadius>
    <radialBlurIterations>2</radialBlurIterations>
    <sunShaftIntensity>1.3</sunShaftIntensity>
    <useSkyBoxAlpha>0.75</useSkyBoxAlpha>
    <followMainLight>true</followMainLight>
    <lightDistance>50</lightDistance>
    <sunPosX>0</sunPosX>
    <sunPosY>20</sunPosY>
    <sunPosZ>0</sunPosZ>
  </sunShafts>
  <whiteBalance>
    <enabled>true</enabled>
    <temperature>25</temperature>
    <tint>5</tint>
  </whiteBalance>
  <tonemappingColorGrading>
    <enabled>true</enabled>
    <colorGradingEnabled>true</colorGradingEnabled>
    <shadows>
      <r>0.9</r>
      <g>0.85</g>
      <b>1.05</b>
      <a>1</a>
    </shadows>
    <midtones>
      <r>1.05</r>
      <g>0.98</g>
      <b>0.92</b>
      <a>1</a>
    </midtones>
    <highlights>
      <r>1.1</r>
      <g>1</g>
      <b>0.85</b>
      <a>1</a>
    </highlights>
    <temperatureShift>0</temperatureShift>
    <tint>0</tint>
    <hue>0</hue>
    <saturation>1.1</saturation>
    <vibrance>0.15</vibrance>
    <colorGradingValue>1</colorGradingValue>
    <colorGradingContrast>1.05</colorGradingContrast>
    <colorGradingGain>1</colorGradingGain>
    <colorGradingGamma>1</colorGradingGamma>
    <useDithering>true</useDithering>
  </tonemappingColorGrading>
  <cinematicLensAberrations>
    <enabled>true</enabled>
    <distortionEnabled>false</distortionEnabled>
    <distortionAmount>0</distortionAmount>
    <distortionCenterX>0</distortionCenterX>
    <distortionCenterY>0</distortionCenterY>
    <distortionAmountX>1</distortionAmountX>
    <distortionAmountY>1</distortionAmountY>
    <distortionScale>1</distortionScale>
    <vignetteEnabled>true</vignetteEnabled>
    <vignetteColor>
      <r>0.1</r>
      <g>0.02</g>
      <b>0</b>
      <a>1</a>
    </vignetteColor>
    <vignetteCenterX>0.5</vignetteCenterX>
    <vignetteCenterY>0.5</vignetteCenterY>
    <vignetteIntensity>0.9</vignetteIntensity>
    <vignetteSmoothness>1.4</vignetteSmoothness>
    <vignetteRoundness>1</vignetteRoundness>
    <vignetteBlur>0</vignetteBlur>
    <vignetteDesaturate>0</vignetteDesaturate>
    <chromaticAberrationEnabled>false</chromaticAberrationEnabled>
    <chromaticAberrationColor>
      <r>0</r>
      <g>1</g>
      <b>0</b>
      <a>1</a>
    </chromaticAberrationColor>
    <chromaticAberrationAmount>0</chromaticAberrationAmount>
  </cinematicLensAberrations>
</PostEffectsPreset>
