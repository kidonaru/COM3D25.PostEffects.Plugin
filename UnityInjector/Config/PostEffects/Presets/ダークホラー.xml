<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <vignetting>
    <enabled>true</enabled>
    <gameEffectDisabled>false</gameEffectDisabled>
    <mode>Simple</mode>
    <intensity>0.7</intensity>
    <blur>0.4</blur>
    <blurSpread>1</blurSpread>
    <chromaticAberration>0.5</chromaticAberration>
    <axialAberration>0.5</axialAberration>
    <luminanceDependency>0.4</luminanceDependency>
    <blurDistance>1.2</blurDistance>
  </vignetting>
  <noiseAndGrain>
    <enabled>true</enabled>
    <intensityMultiplier>0.4</intensityMultiplier>
    <generalIntensity>0.5</generalIntensity>
    <blackIntensity>1.2</blackIntensity>
    <whiteIntensity>0.6</whiteIntensity>
    <midGrey>0.2</midGrey>
    <softness>0.25</softness>
    <monochrome>true</monochrome>
    <monochromeTiling>64</monochromeTiling>
    <tilingX>64</tilingX>
    <tilingY>64</tilingY>
    <tilingZ>64</tilingZ>
  </noiseAndGrain>
  <tonemappingColorGrading>
    <enabled>true</enabled>
    <colorGradingEnabled>true</colorGradingEnabled>
    <shadows>
      <r>0.85</r>
      <g>0.92</g>
      <b>1.05</b>
      <a>1</a>
    </shadows>
    <midtones>
      <r>0.95</r>
      <g>1</g>
      <b>1.02</b>
      <a>1</a>
    </midtones>
    <highlights>
      <r>0.95</r>
      <g>1</g>
      <b>1</b>
      <a>1</a>
    </highlights>
    <temperatureShift>-0.4</temperatureShift>
    <tint>0</tint>
    <hue>0</hue>
    <saturation>0.6</saturation>
    <vibrance>0</vibrance>
    <colorGradingValue>0.92</colorGradingValue>
    <colorGradingContrast>1.15</colorGradingContrast>
    <colorGradingGain>1</colorGradingGain>
    <colorGradingGamma>0.95</colorGradingGamma>
    <useDithering>true</useDithering>
  </tonemappingColorGrading>
  <globalFog>
    <enabled>true</enabled>
    <fogMode>Distance</fogMode>
    <startDistance>8</startDistance>
    <globalDensity>0.5</globalDensity>
    <heightScale>100</heightScale>
    <height>0</height>
    <fogColor>
      <r>0.08</r>
      <g>0.09</g>
      <b>0.12</b>
      <a>1</a>
    </fogColor>
  </globalFog>
</PostEffectsPreset>
