<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <cinematicBloom>
    <enabled>true</enabled>
    <threshold>1.1</threshold>
    <softKnee>0.5</softKnee>
    <radius>2.5</radius>
    <intensity>0.8</intensity>
    <maxIntensity>2</maxIntensity>
    <highQuality>true</highQuality>
    <antiFlicker>true</antiFlicker>
    <useDirtTexture>false</useDirtTexture>
    <dirtIntensity>0</dirtIntensity>
    <dirtTexturePath />
  </cinematicBloom>
  <cinematicLensAberrations>
    <enabled>true</enabled>
    <distortionEnabled>false</distortionEnabled>
    <distortionAmount>0</distortionAmount>
    <distortionCenterX>0</distortionCenterX>
    <distortionCenterY>0</distortionCenterY>
    <distortionAmountX>1</distortionAmountX>
    <distortionAmountY>1</distortionAmountY>
    <distortionScale>1</distortionScale>
    <vignetteEnabled>true</vignetteEnabled>
    <vignetteColor>
      <r>0</r>
      <g>0</g>
      <b>0</b>
      <a>1</a>
    </vignetteColor>
    <vignetteCenterX>0.5</vignetteCenterX>
    <vignetteCenterY>0.5</vignetteCenterY>
    <vignetteIntensity>1.1</vignetteIntensity>
    <vignetteSmoothness>1.2</vignetteSmoothness>
    <vignetteRoundness>1</vignetteRoundness>
    <vignetteBlur>0</vignetteBlur>
    <vignetteDesaturate>0</vignetteDesaturate>
    <chromaticAberrationEnabled>true</chromaticAberrationEnabled>
    <chromaticAberrationColor>
      <r>0</r>
      <g>1</g>
      <b>0</b>
      <a>1</a>
    </chromaticAberrationColor>
    <chromaticAberrationAmount>0.4</chromaticAberrationAmount>
  </cinematicLensAberrations>
  <filmicLetterBox>
    <enabled>true</enabled>
    <color>
      <r>0</r>
      <g>0</g>
      <b>0</b>
      <a>1</a>
    </color>
    <centerX>0.5</centerX>
    <centerY>0.5</centerY>
    <position>0.12</position>
    <smoothness>0.001</smoothness>
    <vertical>false</vertical>
  </filmicLetterBox>
  <tonemappingColorGrading>
    <enabled>true</enabled>
    <tonemappingEnabled>true</tonemappingEnabled>
    <tonemapper>Neutral</tonemapper>
    <tonemappingExposure>1.05</tonemappingExposure>
    <colorGradingEnabled>true</colorGradingEnabled>
    <shadows>
      <r>0.95</r>
      <g>0.98</g>
      <b>1.05</b>
      <a>1</a>
    </shadows>
    <midtones>
      <r>1</r>
      <g>1</g>
      <b>1</b>
      <a>1</a>
    </midtones>
    <highlights>
      <r>1.04</r>
      <g>1.01</g>
      <b>0.96</b>
      <a>1</a>
    </highlights>
    <temperatureShift>0</temperatureShift>
    <tint>0</tint>
    <hue>0</hue>
    <saturation>1.05</saturation>
    <vibrance>0.1</vibrance>
    <colorGradingValue>1</colorGradingValue>
    <colorGradingContrast>1.08</colorGradingContrast>
    <colorGradingGain>1</colorGradingGain>
    <colorGradingGamma>1</colorGradingGamma>
    <useDithering>true</useDithering>
  </tonemappingColorGrading>
  <casSharpen>
    <enabled>true</enabled>
    <sharpness>0.35</sharpness>
  </casSharpen>
</PostEffectsPreset>
