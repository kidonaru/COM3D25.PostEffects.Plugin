<?xml version="1.0"?>
<PostEffectsPreset xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <streak>
    <enabled>true</enabled>
    <threshold>0.9</threshold>
    <softKnee>0.5</softKnee>
    <stretch>0.8</stretch>
    <intensity>0.5</intensity>
    <streakVertical>false</streakVertical>
    <streak2Way>true</streak2Way>
    <tint>
      <r>0.3</r>
      <g>0.6</g>
      <b>1</b>
      <a>1</a>
    </tint>
    <blendMode>Screen</blendMode>
  </streak>
  <cinematicBloom>
    <enabled>true</enabled>
    <threshold>1</threshold>
    <softKnee>0.5</softKnee>
    <radius>3</radius>
    <intensity>1</intensity>
    <maxIntensity>2</maxIntensity>
    <highQuality>true</highQuality>
    <antiFlicker>true</antiFlicker>
    <useDirtTexture>false</useDirtTexture>
    <dirtIntensity>0</dirtIntensity>
    <dirtTexturePath />
  </cinematicBloom>
  <analogGlitch>
    <enabled>true</enabled>
    <scanLineJitter>0.03</scanLineJitter>
    <verticalJump>0</verticalJump>
    <horizontalShake>0</horizontalShake>
    <colorDrift>0.08</colorDrift>
  </analogGlitch>
  <tonemappingColorGrading>
    <enabled>true</enabled>
    <colorGradingEnabled>true</colorGradingEnabled>
    <shadows>
      <r>0.9</r>
      <g>0.95</g>
      <b>1.15</b>
      <a>1</a>
    </shadows>
    <midtones>
      <r>1</r>
      <g>0.97</g>
      <b>1.05</b>
      <a>1</a>
    </midtones>
    <highlights>
      <r>1.05</r>
      <g>0.95</g>
      <b>1.05</b>
      <a>1</a>
    </highlights>
    <temperatureShift>-0.3</temperatureShift>
    <tint>0.3</tint>
    <hue>0</hue>
    <saturation>1.2</saturation>
    <vibrance>0.2</vibrance>
    <colorGradingValue>1</colorGradingValue>
    <colorGradingContrast>1.1</colorGradingContrast>
    <colorGradingGain>1</colorGradingGain>
    <colorGradingGamma>0.98</colorGradingGamma>
    <useDithering>true</useDithering>
  </tonemappingColorGrading>
  <filmicLetterBox>
    <enabled>true</enabled>
    <color>
      <r>0</r>
      <g>0</g>
      <b>0</b>
      <a>1</a>
    </color>
    <centerX>0.5</centerX>
    <centerY>0.5</centerY>
    <position>0.1</position>
    <smoothness>0.001</smoothness>
    <vertical>false</vertical>
  </filmicLetterBox>
</PostEffectsPreset>
